{
    "version": "0.1.0",
    "configurations": [
        {
            // DEBUG BUILD
            "name": "Debug (MinGW / gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/DTR-system.exe",
            "args": [],
            "stopAtEntry": false, // false run till breakpoint
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Qt/6.11.1/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
                }
            ],

            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/Tools/mingw1310_64/bin/gdb.exe",

            "setupCommands": [
                {
                    "description": "Readable std::string / std::vector instead of raw memory",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],

            "preLaunchTask": "CMake: build debug"
        },
        {
            // RELEASE BUILD
            "name": "Release (Run Only)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/DTR-system.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/release",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Qt/6.11.1/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/Tools/mingw1310_64/bin/gdb.exe",
            "preLaunchTask": "CMake: build release"
        },
        
    ]
}