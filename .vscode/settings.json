{
    "cmake.useCMakePresets": "always", // Use CMakePresets instead of CMake Tools' own "kits"
    "cmake.configureOnOpen": false, // Auto-configure on open off
    "cmake.revealLog": "never", // Never focuses on the build output panel everytime
    "clangd.arguments": [ // Clangd autocomplete and live clang-tidy warnings
        "--compile-commands-dir=${workspaceFolder}/build/debug",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--background-index",
        "--completion-style=detailed",
        "--query-driver=C:/Qt/Tools/mingw1310_64/bin/g++.exe" // to avoid turning this into a wall of fake errors
    ],
    "C_Cpp.intelliSenseEngine": "disabled", // Use only clangd for IntelliSense instead of C/C++. both of them do it
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 2
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 2
    },
    "[cmake]": {
        "editor.tabSize": 4
    },
    // Never format sqlite3.c since this already have clean diff formatting plus its 250,000+ lines.
    "[c][sqlite3.c]": {
        "editor.formatOnSave": false
    },
    // Hiding these to avoid having inefficient return hits from Qt and Limereport sources
    "files.exclude": {
        "**/build": true,
        "**/.deps": true,
        "**/.cache": true,
        "**/.qtcreator": true
    },
    "search.exclude": {
        "**/build": true,
        "**/.deps": true,
        "**/installer/out": true,
        "**/installer/packages/*/data": true,
        "sqlite3.c": true,
        "sqlite3.h": true
    },
    // Avoid lookinng for changes in generated folders to avoud wasting CPU resources
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.deps/**": true
    },
    // File types specific to this project
    "files.associations": {
        "*.ui": "xml",
        "*.qrc": "xml",
        "*.lrxml": "xml",
        "*.qss": "css",
        "*.qs": "javascript",
        "*.xml.in": "xml"
    },
    // The Qt Extension
    "qt-core.qtFolder": "C:/Qt",
    // to open .ui files in the Qt Designer instead of showing its raw XML
    "qt-ui.setDefaultEditor": true
}