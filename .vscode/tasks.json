{
    "version": "2.0.0",
    "tasks": [
        // Configure. needed only after editing CMakeLists.txt. also run build task automatically the first time
        {
            "label": "CMake: configure debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "First run clones and builds Limereport -- expect few minutes."
        },
        {
            "label": "CMake: configure release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Regenerates installer config.xml and package.xml from the .in templates."
        },
        // BUILD
        {
            "label": "CMake: build debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: configure debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }, // isDefault means Ctrl+Shift+B runs this
            "problemMatcher": [
                "$gcc"
            ], // turns compiler errors to clickable entries in PROBLEMS panel
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Every build"
        },
        {
            "label": "CMake: build release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: configure release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Optimized build. Run this before packaging."
        },
        // QT DESIGNER - open current .ui in Designer App
        {
            "label": "Qt: open current .ui in Designer App",
            "type": "shell",
            "command": "C:/Qt/6.11.1/mingw_64/bin/designer.exe",
            "args": [
                "${file}"
            ],
            "problemMatcher": [],
            "detail": "Save and close Designer, then rebuild. uic regenerates ui_*.h."
        },
        // CLANG-TIDY
        {
            "label": "clang-tidy: check project sources",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-ChildItem -Path . -Filter *.cpp -File | Where-Object { $_.Name -ne 'sqlite3.c' }  | ForEach-Object { Write-Host ('--- ' + $_.Name); clang-tidy -p build/debug $_.FullName }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "Needs the debug preset configured first (reads compile_commands.json)."
        },
        {
            "label": "clang-tidy: check current file",
            "type": "shell",
            "command": "clang-tidy",
            "args": [
                "-p",
                "build/debug",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Faster than the whole project when iterating."
        },
        // RELEASE PIPELINE
        {
            "label": "Release: stage installer payload",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--install",
                "build/release",
                "--prefix",
                "installer/packages/DTR-system/data"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: build release"
            ],
            "problemMatcher": [],
            "detail": "Runs windeployqt so payload folder runs on PC with no Qt."
        },
        {
            "label": "Release: build instalelrs",
            "type": "shell",
            "command": "C:/Program Files/Git/bin/bash.exe",
            "args": [
                "installer/build_installer.sh",
                "C:/Qt/Tools/QtInstallerFramework/4.8/bin"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Produces installer/out/ !Keep every offline .exe forever --rollback depends on this"
        },
        // HOUSEKEEPING
        {
            "label": "CMake: clean build folders",
            "type": "shell",
            "command": "Remove-Item",
            // Deletes build/ but not /deps/; LimeReport also stays so next configuration no download required
            "args": [
                "-Recurse",
                "-Force",
                "-ErrorAction",
                "SilentlyContinue",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "detail": "Try this when build behaves impossibly."
        },
        {
            "label": "CMake: cleans EVERYTHING including LimeReport", // this will require LimeReport downloading next configure
            "type": "shell",
            "command": "Remove-Item",
            "args": [
                "-Recurse",
                "-Force",
                "-ErrorAction",
                "SilentlyContinue",
                "build",
                ".deps"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "detail": "Go Berserk or Nuclear. next configure re-downloads LimeReport and needs network connection."
        }
    ]
}